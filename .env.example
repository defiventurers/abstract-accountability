# Add these as server-side Vercel environment variables. Never commit real tokens.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token
# Generate a long random token for the /moderate dashboard.
ADMIN_TOKEN=your-private-moderation-token
# Optional; leave unset to use the current request origin.
SITE_URL=https://your-domain.example
